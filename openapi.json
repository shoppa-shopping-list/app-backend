                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        },
                        "required": [
                          "color",
                          "createdAt",
                          "id",
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    }
