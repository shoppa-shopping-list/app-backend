{
  "name": "shoppa-app-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest",
    "test:ci": "vitest run",
    "openapi": "tsx src/openapi.ts",
    "openapi:check": "tsx src/openapi.ts --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci && npm run openapi:check && npm run build",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
