# A fresh clone needs no .env at all — every var below has a working default,
# or (for the commented-out ones) isn't wired up yet.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
STATE_PATH=./data/state.json
LOG_LEVEL=info
LOG_PRETTY=0
STRICT_DIR_FSYNC=

# --- Not wired up yet — §5/§7 of docs/architecture-design.md (D16, D26) ---
# TELEGRAM_API_BASE=   # Cloudflare Worker relay URL, NOT api.telegram.org (D26)
# RELAY_SECRET=        # authenticates this Pi to the Worker (D26)
# BOT_TOKEN=           # lives as a Worker secret AND is needed on the Pi for local initData HMAC (D16, §7)
# SESSION_SECRET=      # signs the session cookie (D16)
# OWNER_USER_ID=       # default snapshot chat (§7)
# SNAPSHOT_CHAT_ID=    # optional override, e.g. a private channel (§7)
# ALLOWED_USER_IDS=    # comma-separated, two entries (D16)
# FLUSH_DEBOUNCE_MS=15000   # §2.1
