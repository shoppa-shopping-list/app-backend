# A fresh clone needs no .env at all — every var below has a working default,
# or (for the commented-out ones) isn't wired up yet. Auth (D16) is the exception: it
# works with no .env (buildApp() never requires these), but every request is then a 500
# auth_not_configured rather than a working handshake — set the three below to actually
# use it locally.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
STATE_PATH=./data/state.json
LOG_LEVEL=info
LOG_PRETTY=0
STRICT_DIR_FSYNC=

# --- Auth (D16) — needed on the Pi as well as locally. On a deployed unit, keep any
# --- explanation on its own comment line above, never trailing on the value's line —
# --- systemd's EnvironmentFile doesn't strip inline `#` comments (see root CLAUDE.md).
# BOT_TOKEN=
# SESSION_SECRET=
# ALLOWED_USER_IDS=

# --- Not wired up yet — §5/§7 of docs/architecture-design.md (D26) ---
# TELEGRAM_API_BASE=   # Cloudflare Worker relay URL, NOT api.telegram.org (D26)
# RELAY_SECRET=        # authenticates this Pi to the Worker (D26)
# OWNER_USER_ID=       # default snapshot chat (§7)
# SNAPSHOT_CHAT_ID=    # optional override, e.g. a private channel (§7)
# FLUSH_DEBOUNCE_MS=15000   # §2.1
