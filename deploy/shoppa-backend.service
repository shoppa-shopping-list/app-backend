[Unit]
Description=Shoppa backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lit
WorkingDirectory=/home/lit/projects/shoppa-app-backend
Environment=NODE_ENV=production
EnvironmentFile=-/home/lit/projects/shoppa-app-backend/.env
# Stays the parent dir, not current/: .env and data/ (STATE_PATH=./data/...) live here.
# Node resolves the current/ symlink to the real release dir, so ../public and node_modules
# resolve inside that release.
ExecStart=/usr/local/bin/node current/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
